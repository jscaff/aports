pkgname=python3-psutil
_pkgname=psutil
_pkgver=7.2.2
pkgver="$_pkgver"_alpha
pkgrel=0
_portrel=0
pkgdesc="A cross-platform process and system utilities module for Python"
url="https://github.com/qnx-ports/psutil"
arch="all"
license="BSD-3-Clause"
makedepends="python3-dev python3-gpep517 python3-setuptools python3-wheel qnx-io-sock-dev"
source="https://github.com/qnx-ports/$_pkgname/archive/refs/tags/qnx-release-$_pkgver-r$_portrel.tar.gz"
builddir="$srcdir/$_pkgname-qnx-release-$_pkgver-r$_portrel"

# secfixes:
#   5.6.7-r0:
#     - CVE-2019-18874

build() {
    CFLAGS="$CFLAGS -fPIC" \
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
    # No tests implemented for QNX yet
	default_check
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
	rm -fr "$pkgdir"/usr/lib/python3*/site-packages/psutil/tests/
}



