# Alpine-Maintainer: Achill Gilgenast <achill@achill.org>
# Maintainer: jscaffidi <jscaffidi@qnx.com>
pkgname=buildbot-worker
pkgver=4.3.0
pkgrel=0
pkgdesc="Python-based continuous integration testing framework"
url="https://www.buildbot.net/"
arch="noarch"
license="GPL-3.0-only"
depends="python3-twisted python3-autobahn python3-msgpack python3-zope-interface"
makedepends="
	python3-gpep517
	python3-setuptools
	python3-wheel
	"
checkdepends="python3-parameterized"
builddir="$srcdir/buildbot-$pkgver/worker"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/buildbot/buildbot/archive/refs/tags/v$pkgver.tar.gz
	"

get_pyver() {
	python -c "import sys; print('{}.{}'.format(*sys.version_info[:2]))"
}

build() {
    PYTHONPATH="$srcdir/.tmp/usr/lib/python$(get_pyver)/site-packages" \
    gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2

    # pkg is required for www, www is required for tests
    python3 -m installer -d "$srcdir/.tmp" .dist/*.whl
}

check() {
	export PYTHONPATH="$srcdir/.tmp/usr/lib/python$(get_pyver)/site-packages"

	trial buildbot_worker
}

package() {
	cd "$builddir"
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}



sha512sums="
f86f7b1ed0b9abaad8ed6e6bc2e5d42dea43c09efc4bec93aa6a27dde8baff1f68df829a05cf890c82378a9d8bc91d26c7f24180876b15d316b1b80f3bbc0eed  buildbot-worker-4.3.0.tar.gz
"
