pkgname=unbound
pkgver=1.24.2
pkgrel=0
pkgdesc="Unbound is a validating, recursive, and caching DNS resolver"
url="https://nlnetlabs.nl/projects/unbound/about/"
arch="all"
license="BSD-3-Clause"
depends="dnssec-root"
depends_dev="expat-dev"
makedepends="$depends_dev
	hiredis-dev
	libevent-dev
	nghttp2-dev
	openssl-dev>3
	protobuf-c-dev
	python3-dev
	swig
    autoconf
	"
# checkdepends="
# 	bind-tools
# 	ldns-tools
# 	"
install="$pkgname.pre-install"
pkgusers="unbound"
pkggroups="unbound"
subpackages="
	$pkgname-dbg
	$pkgname-dev
	$pkgname-doc
	$pkgname-libs
	py3-unbound:py
	"
source="
    https://unbound.net/downloads/unbound-$pkgver.tar.gz
    qnx-build.patch
    qnx-endian.patch
    swig-4.4.patch
    use-system-default-so-sndbuf.patch
"

# secfixes:
