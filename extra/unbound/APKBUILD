prepare() {
    default_prepare
    # We patched the configure.ac file, we need to regenerate the configure and header template
    autoheader
    autoconf
}

build() {
	CFLAGS="$CFLAGS -Qunused-arguments" \
    CPPFLAGS="$CPPFLAGS -Qunused-arguments" \
	CC=clang \
    PYTHON_VERSION=3 \
    ./configure \
        --build="$CBUILD" \
		--host="$CHOST" \
		--prefix=/usr \
		--sbindir=/usr/bin \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var \
		--enable-pie \
		--enable-relro-now \
		--with-username=unbound \
		--with-run-dir="" \
		--with-pidfile="" \
		--with-rootkey-file=/usr/share/dnssec-root/trusted-key.key \
		--with-libevent \
		--with-pthreads \
		--disable-static \
		--disable-rpath \
		--disable-dsa \
		--disable-gost \
		--enable-dnstap \
		--enable-subnet \
		--enable-cachedb \
		--with-ssl \
		--without-pythonmodule \
		--with-pyunbound \
		--with-libhiredis \
		--with-libnghttp2


	# do not link to libpython
    sed -i -e '/^LIBS=/s/-lpython.*[[:space:]]/ /' Makefile

	make
}

check() {
	make test
}

package() {
	make DESTDIR="$pkgdir" install
	make DESTDIR="$pkgdir" unbound-event-install

	install -Dm755 contrib/update-anchor.sh \
		"$pkgdir"/usr/share/$pkgname/update-anchor.sh

	install -D -m644 doc/CREDITS doc/Changelog doc/FEATURES \
		doc/README doc/TODO -t "$pkgdir"/usr/share/doc/$pkgname/
}

py() {
	pkgdesc="Python bindings to libunbound"
	depends=""
	provides="py-unbound=$pkgver-r$pkgrel" # backward compatibility (Alpine <3.23)

	amove usr/lib/python*
}


