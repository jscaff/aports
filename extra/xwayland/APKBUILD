# options="!check" # requires piglit, which has no stable releases
subpackages="$pkgname-dbg $pkgname-dev $pkgname-doc"
depends="xorg-server-common xkbcomp libdecor libxfont2 libxshmfence wayland libmd libxcvt libxau pixman qnx-libdrm"
depends_dev="
