# Alpine-Contributor: Kaarle Ritvanen <kunkku@alpinelinux.org>
# Alpine-Maintainer: Kaarle Ritvanen <kunkku@alpinelinux.org>
# Maintainer: jscaffidi <jscaffidi@qnx.com>
pkgname=python3-babel
_pkgname=babel
pkgver=2.18.0
pkgrel=0
pkgdesc="Python3 i18n tool"
url="https://babel.pocoo.org/"
arch="noarch"
license="BSD-3-Clause"
depends="python3-tz python3-setuptools"
makedepends="python3-gpep517 python3-wheel"
checkdepends="python3-pytest python3-pytest-freezegun"
source="https://files.pythonhosted.org/packages/source/${_pkgname:0:1}/$_pkgname/$_pkgname-$pkgver.tar.gz"
builddir="$srcdir/$_pkgname-$pkgver"
options="!check" # freezegun not in main

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
e8fafa5d026dbb3aa02eca0ca2c08bb80adf78825a4b4d71c15a1c6d142bac058adfe38b8b52ce3fab42fcea615c8e543ee28dfe3ad50b4598e6b1b587be59fe  babel-2.18.0.tar.gz
"


