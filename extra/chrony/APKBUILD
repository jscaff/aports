pkgname=chrony
pkgver=3.5
pkgrel=0
pkgdesc="Advanced NTP client and server"
url="https://github.com/raysan5/raylib"
arch="x86_64"
license="GPLv2"
pkgusers="$pkgname"
pkggroups="$pkgname"
commit="04328ceeadf7e2b68f246cb4deab9348f4e02825"
builddir="$srcdir"/$pkgname-$commit
source="
$pkgname-$pkgver.tar.gz::https://gitlab.com/chrony/chrony/-/archive/$commit/chrony-$commit.tar.gz
sys_qnx.c
sys_qnx.h
adjtime_qnx.h
00-configure.patch
01-sys.patch
02-sysincl.patch
03-samplefilt.patch
04-makefile.patch
05-util-test.patch
06-test-random.patch
07-test-common.patch
chrony.conf
chronyd.confd
"

makedepends="bison make clang qnx-io-sock-dev nettle-dev"

depends="qnx-io-sock nettle"

prepare() {
    default_prepare
	cp $srcdir/sys_qnx.c $srcdir/sys_qnx.h $srcdir/adjtime_qnx.h .
}

build() {
    export CC=clang
    export CFLAGS=" -Wno-deprecated-non-prototype"
    ./configure \
		--prefix=/usr \
        --sbindir=/usr/bin \
        --sysconfdir=/etc/$pkgname \
        --chronyrundir=/run/$pkgname \
        --with-pidfile=/run/$pkgname/chronyd.pid \
		--with-user=$pkgname
    make 
}

check() {
    make check
}

package() {
    make DESTDIR="$pkgdir" install

	install -dm2750 -g wheel "$pkgdir"/var/log/chrony

	mkdir -p "$pkgdir"/var/lib/chrony \
		"$pkgdir"/etc/chrony

	install -m644 "$srcdir"/chrony.conf "$pkgdir"/etc/chrony/chrony.conf
}

