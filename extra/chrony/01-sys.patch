diff --git a/sys.c b/sys.c
index f3797c4..313ca82 100644
--- a/sys.c
+++ b/sys.c
@@ -44,6 +44,9 @@
 #include "sys_posix.h"
 #elif defined(MACOSX)
 #include "sys_macosx.h"
+#elif defined(QNX)
+#include "sys_qnx.h"
+#include "sys_posix.h"
 #endif
 
 /* ================================================== */
@@ -68,6 +71,8 @@ SYS_Initialise(int clock_control)
   SYS_NetBSD_Initialise();
 #elif defined(MACOSX)
   SYS_MacOSX_Initialise();
+#elif defined(QNX)
+  SYS_QNX_Initialise();
 #else
 #error Unknown system
 #endif
@@ -90,6 +95,8 @@ SYS_Finalise(void)
   SYS_NetBSD_Finalise();
 #elif defined(MACOSX)
   SYS_MacOSX_Finalise();
+#elif defined(QNX)
+  SYS_QNX_Finalise();
 #else
 #error Unknown system
 #endif
@@ -107,6 +114,8 @@ void SYS_DropRoot(uid_t uid, gid_t gid)
   SYS_NetBSD_DropRoot(uid, gid);
 #elif defined(MACOSX) && defined(FEAT_PRIVDROP)
   SYS_MacOSX_DropRoot(uid, gid);
+#elif defined(QNX) && defined(FEAT_PRIVDROP)
+  SYS_QNX_DropRoot(uid, gid);
 #else
   LOG_FATAL("dropping root privileges not supported");
 #endif
