# Alpine-Contributor: Peter Bui <pnutzh4x0r@gmail.com>
# Alpine-Maintainer: Patrycja Rosa <alpine@ptrcnull.me>
# Maintainer: jscaffidi <jscaffidi@qnx.com>
pkgname=python3-asn1
pkgver=0.6.3
pkgrel=0
pkgdesc="Python3 ASN1 library"
url="https://github.com/pyasn1/pyasn1"
arch="noarch"
license="BSD-2-Clause"
depends="python3"
makedepends="python3-gpep517 python3-setuptools python3-wheel"
checkdepends="python3-pytest"
source="https://files.pythonhosted.org/packages/source/p/pyasn1/pyasn1-$pkgver.tar.gz"
builddir="$srcdir/pyasn1-$pkgver"

build() {
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
}

sha512sums="
c58962b3f11f486da3e73c09dbe2aff7500879b29c4a7be4295878e4edbcaaa2680d608720ad5af86a2457de7da50471ab7a9e925f717db5c467553fc552e6d6  pyasn1-0.6.3.tar.gz
"


