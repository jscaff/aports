# Contributor:
# Maintainer:
pkgname=python3-pydocstyle
pkgver=6.3.0
pkgrel=0
pkgdesc="docstring style checker" 
url="https://github.com/PyCQA/pydocstyle"
arch="all"
license="MIT"
depends=""
makedepends="python3-gpep517 python3-setuptools python3-wheel"
subpackages="$pkgname-dev $pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://github.com/PyCQA/pydocstyle/archive/refs/tags/$pkgver.tar.gz"

# TODO: Deprecated but needed for ROS2

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

