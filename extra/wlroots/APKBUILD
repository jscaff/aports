# Alpine-Contributor: Henrik Riomar <henrik.riomar@gmail.com>
# Alpine-Maintainer: Achill Gilgenast <achill@achill.org>
# Maintainer: Aaron Bassett <abassett@qnx.com>
pkgname=wlroots0.20
pkgver=0.20.2
_pkgver=${pkgver/_/-}
pkgrel=1
pkgdesc="Modular Wayland compositor library"
url="https://gitlab.freedesktop.org/wlroots/wlroots"
license="MIT"
arch="all"
depends="libxkbcommon lcms2 pixman wayland qnx-screen qnx-libdrm qnx-libgbm qnx-egl qnx-gles qnx-io-sock qnx-fd-notify"
makedepends="
	libxkbcommon-dev
    cmake
	lcms2-dev
	meson
	ninja
	pixman-dev
	wayland-dev
	wayland-protocols
	qnx-screen-dev
	qnx-libdrm-dev
	qnx-libgbm-dev
	qnx-io-sock-dev
	qnx-fd-notify-dev
	egl-headers
	gles-headers
    linux-headers-input-codes
	"
# wlroots >= 0.18.0 does no longer ship a libwlroots.so symlink in the -dev
# subpackage. Hence, abuild's dependency tracing fails to identify that the
# -dev subpackage depends on the origin package and we need to add that
# manually. Otherwise, the wlroots shared object is not installed with -dev.
depends_dev="$pkgname=$pkgver-r$pkgrel qnx-libdrm-dev qnx-libgbm-dev  qnx-screen-dev wayland-protocols wayland-dev pixman-dev lcms2-dev libxkbcommon-dev"
subpackages="$pkgname-dbg $pkgname-static $pkgname-dev"
source="https://github.com/qnx-ports/wlroots/archive/refs/heads/qnx-$_pkgver.tar.gz"
builddir="$srcdir/wlroots-qnx-$_pkgver"
options="!check" # no test suite

# whether this is the default version (latest stable wlroots)
_default="yes"

if [ "$_default" = yes ]; then
	provides="wlroots=$pkgver-r$pkgrel"
	replaces="wlroots"

	dev() {
		default_dev
		provides="wlroots-dev=$pkgver-r$pkgrel"
		replaces="wlroots-dev"
	}
fi

build() {
	#-Db_lto=true \
	abuild-meson \
		-Dexamples=false \
		-Ddefault_library=both \
		-Drenderers=gles2 \
		-Dallocators=gbm \
		-Dc_args="-D__EXPORTED_HEADERS__" \
		-Dc_link_args="-lsocket -leventfd" \
		. build
	meson compile -C build
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C build
}


sha512sums="
9e96aad6f940ad90710611034b90126d11cc1ad578f3c976871775eec1f0e1e626be16fc254124a962496ebdce5b08862e8a50246e013cfd44ec0826deb0f951  qnx-0.20.2.tar.gz
"
