# Contributor: André Klitzing <aklitzing@gmail.com>
# Maintainer: André Klitzing <aklitzing@gmail.com>
pkgname=ripgrep
pkgver=15.1.0
pkgrel=0
pkgdesc="ripgrep combines the usability of The Silver Searcher with the raw speed of grep"
url="https://github.com/BurntSushi/ripgrep"
arch="all"
license="MIT OR Unlicense"
makedepends="
	pcre2-dev
	"
checkdepends="xz"
subpackages=""
source="https://github.com/BurntSushi/ripgrep/archive/$pkgver/ripgrep-$pkgver.tar.gz
	"

export PCRE2_SYS_STATIC=0  # use system libpcre2
export JEMALLOC_SYS_WITH_LG_PAGE=16 # 2**16 = 64k
options="!check"

prepare() {
	default_prepare

        echo '[patch.crates-io]' >> "$builddir"/Cargo.toml
        echo 'libc = { git = "https://github.com/qnx-ports/libc-rs", branch = "qnx-0.2.183" }' >> "$builddir"/Cargo.toml
        echo 'cc = { git = "https://github.com/qnx-ports/cc-rs", branch = "qnx-1.2.48" }' >> "$builddir"/Cargo.toml

	cargo update
}

build() {
	cargo build --release --features 'pcre2'
}

check() {
    default_check
    # Fails some sorting thing
	# cargo test --features 'pcre2'
}

package() {
	install -Dm755 target/release/rg \
		-t "$pkgdir"/usr/bin/
}

sha512sums="
3e54683ceaaa79e6e1b52f7e1b92aefaf0b8f721daf2ab6433e1f45931878904ca20379cfb9b13770bf79d06a21ce896d471e80f557c6614417b836aabb6b803  ripgrep-15.1.0.tar.gz
"


