# Alpine-Maintainer: Francesco Colista <fcolista@alpinelinux.org>
# Maintainer: jscaffidi <jscaffidi@qnx.com>
pkgname=python3-service_identity
_pkgname=service-identity
pkgver=24.2.0
pkgrel=0
pkgdesc="Service identity verification for pyOpenSSL & cryptography."
url="https://pypi.org/project/service-identity/"
arch="noarch"
license="MIT"
depends="python3-asn1 python3-asn1-modules python3-attrs python3-cryptography"
makedepends="python3-gpep517 python3-hatchling python3-hatch-vcs"
checkdepends="python3-idna python3-openssl python3-pytest-runner"
source="$pkgname-$pkgver.tar.gz::https://github.com/pyca/service-identity/archive/$pkgver.tar.gz
	remove-fancy-pypi-readme.patch
	"
builddir="$srcdir/$_pkgname-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

