16df986e2f1da7d19788f9a2d0ef9d2b8a30c7c083aac63f0b12ab4a28b9036cc000946a434d73de41de4678e95ad434cff384bfae5e9ae952b7aeaa4128f88e  remove-fancy-pypi-readme.patch
