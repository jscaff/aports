#Maintainer jscaffidi <jscaffidi@qnx.com>
pkgname=python3-colcon-cmake
_pkgname=colcon-cmake
pkgver=0.2.29
pkgrel=0
pkgdesc="Extension for colcon to support CMake packages "
arch="noarch"
license="Apache"
makedepends="python3-packaging python3-gpep517 python3-distlib python3-empy python3-setuptools"
checkdepends="python3-pytest"
source="$_pkgname-$pkgver.tar.gz::https://github.com/colcon/colcon-cmake/archive/refs/tags/$pkgver.tar.gz"
builddir="$srcdir/$_pkgname-$pkgver"
url="http://colcon.readthedocs.io"
options="!check" # tests failing due to missing dependencies + some warning we are not triggering

prepare() {
    default_prepare
}

build() {
    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

}

package(){
    python3 setup.py install --force --root="$pkgdir" --no-compile -O0 
}


check() {
    python -m pytest
}


sha512sums="
