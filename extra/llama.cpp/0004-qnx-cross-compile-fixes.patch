diff --git a/qnx.toolchain.cmake b/qnx.toolchain.cmake
new file mode 100644
index 0000000..9301c78
--- /dev/null
+++ b/qnx.toolchain.cmake
@@ -0,0 +1,16 @@
+set(CMAKE_SYSTEM_NAME QNX)
+set(CMAKE_SYSTEM_PROCESSOR x86_64)
+
+# Set the path to the SDP
+set(QNX_TARGET $ENV{QNX_TARGET})
+set(QNX_HOST $ENV{QNX_HOST})
+
+# Explicitly point to the x86_64 sysroot
+set(CMAKE_SYSROOT ${QNX_TARGET}/x86_64)
+
+# Force the compiler to use the QNX x86_64 configuration
+set(CMAKE_C_FLAGS "${QNX_FLAGS}" CACHE STRING "Flags for QNX" FORCE)
+set(CMAKE_CXX_FLAGS "${QNX_FLAGS}" CACHE STRING "Flags for QNX" FORCE)
+
+set(CMAKE_C_COMPILER ${QNX_HOST}/usr/bin/x86_64-pc-nto-qnx8.0.0-gcc)
+set(CMAKE_CXX_COMPILER ${QNX_HOST}/usr/bin/x86_64-pc-nto-qnx8.0.0-g++)
