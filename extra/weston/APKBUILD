# Alpine-Contributor: Valery Kartel <valery.kartel@gmail.com>
# Maintainer: Aaron Bassett <abassett@qnx.com>
pkgname=weston
pkgver=14.0.2
pkgrel=6
_commit="3faa6c3ec4ec151c39406835d15174f9759f8818"
_libname=lib$pkgname
_libdir=$_libname-${pkgver%%.*}
pkgdesc="Reference Wayland server"
url="https://wayland.freedesktop.org/"
arch="all"
license="MIT"
depends_dev="$pkgname=$pkgver-r$pkgrel"
depends="$_libname dbus libdisplay-info libjpeg-turbo libwebp libxkbcommon qnx-security pango wayland qnx-io-sock qnx-egl qnx-screen qnx-gles qnx-memstream qnx-fd-notify qnx-libdrm ncurses qnx-libgbm"
options="!strip !check"
makedepends="
	dbus-dev
	libdisplay-info-dev
	libjpeg-turbo-dev
	libwebp-dev
	libxkbcommon-dev
    libxcursor-dev
    libxfixes-dev
    libxrender-dev
	qnx-security-dev
	meson
	pango-dev
	wayland-dev
	wayland-protocols
	xkeyboard-config
	qnx-io-sock-dev
	qnx-egl
	egl-headers
	qnx-screen-dev
	qnx-gles
	gles-headers
	qnx-memstream-dev
	qnx-fd-notify-dev
    qnx-libdrm-dev
    qnx-libgbm-dev
    ncurses-dev
    xwayland-dev
	"
_shell="shell-qnx-desktop shell-desktop shell-fullscreen shell-ivi"
_client="terminal wcap-decode"
_backend="
	backend-qnx-screen
	backend-wayland
	backend-headless
	"
for _sub in $_shell $_client $_backend; do
	subpackages="$subpackages $pkgname-$_sub:_sub"
done
subpackages="
	$pkgname-dev
	$pkgname-doc
	$subpackages
	$pkgname-clients
	$pkgname-xwayland
	$_libname:libs
	"
source="https://github.com/qnx-ports/weston/archive/$_commit.tar.gz
99-debug.patch
	input.h
	pty.h
	qnx-fix.patch
	xfce4-panel.patch
	0002-qnx-taskbar.patch
	0003-qnx-xfce-weston-shell.patch
    0004-os-compatibility.patch
	"
builddir="$srcdir/weston-$_commit"
#install="$pkgname.pre-install"

prepare() {
	mkdir qnx-desktop-shell
	cp desktop-shell/input-panel.c qnx-desktop-shell
	mv desktop-shell/qnx-* qnx-desktop-shell

	default_prepare

	# dodge git version
	git init -q .
	mv qnx/build/nto/libweston/backend-qnx-screen.h include/libweston/
	mv qnx/build/backends/qnx-screen/qnx-* libweston/backend-qnx-screen


	mkdir linux
	cp $srcdir/input.h linux
	cp $srcdir/pty.h .
}

build() {
	abuild-meson \
		-Dc_args="-I/usr/include/libdrm -D_QNX_SOURCE -Wno-int-conversion -g3" \
		-Dc_link_args="-Wl,-lepoll,-leventfd,-ltimerfd,-lsignalfd,-lmemstream,-lsocket,-lgcc_s,-lm,-lgbm" \
        --buildtype=debug \
		-Dbackend-drm=false \
		-Dbackend-vnc=false \
		-Dbackend-x11=false \
		-Dbackend-headless=true \
		-Dbackend-qnx-screen=true \
		-Dbackend-pipewire=false \
		-Dbackend-default=qnx-screen \
		-Dbackend-wayland=true \
		-Dcolor-management-lcms=false \
		-Drenderer-gl=true \
		-Dbackend-rdp=false \
		-Dxwayland=true \
		-Dsystemd=false \
		-Dremoting=false \
		-Dpipewire=false \
		-Dtests=false \
		-Dsimple-clients=damage,im,egl,shm,touch \
		build
	meson compile -C build
}

# Does not run through, see also:
# https://github.com/alpinelinux/aports/pull/1689
check() {
	meson test --print-errorlogs -C build
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C build

	mkdir -p "$pkgdir"/usr/lib
	mv "$pkgdir"/usr/share/pkgconfig/* "$pkgdir"/usr/lib/pkgconfig/
}

libs() {
	depends="xkeyboard-config"
	default_libs
}

clients() {
	pkgdesc="Weston example clients"
	mkdir -p "$subpkgdir"/usr/bin
	mv "$pkgdir"/usr/bin/$pkgname-* "$subpkgdir"/usr/bin
}

xwayland() {
	pkgdesc="Wayland module to run X Clients"
	mkdir -p "$subpkgdir"/usr/lib/$_libdir
	mv "$pkgdir"/usr/lib/$_libdir/xwayland.so \
		"$subpkgdir"/usr/lib/$_libdir
}

_sub() {
	local name path
	case $subpkgname in
	*-shell-*)
		name=${subpkgname#"$pkgname"-shell-}
		path=usr/lib/$pkgname
		pkgdesc="Weston shell: $name"
		name="*$name-shell*"
		;;
	*-backend-*)
		name=${subpkgname#"$pkgname"-backend-}
		path=usr/lib/$_libdir
		pkgdesc="Weston backend: $name"
		name=$name-backend.so
		# grep -q cairo "$pkgdir"/$path/$name && depends="mesa-dri-gallium"
		;;
	*)
		name=$subpkgname
		path=usr/bin
		[ -x "$pkgdir"/$path/$name ] || name=${subpkgname#"$pkgname"-}
		pkgdesc="Weston client: $name"
		;;
	esac
	amove $path/$name
}

