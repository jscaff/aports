# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: jscaffidi <jscaffidi@qnx.com>
pkgname=python3-openssl
# version needs to be compatible with python3-cryptography
pkgver=26.1.0
pkgrel=0
pkgdesc="Python3 wrapper module around the OpenSSL library"
url="https://github.com/pyca/pyopenssl"
arch="noarch"
license="Apache-2.0"
depends="python3 python3-cryptography python3-typing-extensions"
makedepends="
	python3-gpep517
	python3-setuptools
	python3-wheel
	"
checkdepends="
	python3-pretend
	python3-pytest-rerunfailures
	python3-pytest-xdist
	"
source="https://files.pythonhosted.org/packages/source/p/pyOpenSSL/pyopenssl-$pkgver.tar.gz"
builddir="$srcdir/pyopenssl-$pkgver"

build() {
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest -n auto \
		--deselect tests/test_ssl.py::TestContext::test_set_tmp_ecdh
}

package() {
	python3 -m installer -d "$pkgdir" \
		.dist/*.whl
}

sha512sums="
084117296b7013d665d7f30705b26ad5dd2758febfc7080ae656328d40a2e992b74c52abcc39b9243bc9a918b4611f1f497e56928a5789ffc63c0b521357eb9c  pyopenssl-26.1.0.tar.gz
"


