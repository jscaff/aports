pkgname=btop
# Release candidate since our port was built against main, which is breaking from the latest release
pkgver=1.4.7_rc1
_pkgver=1.4.7
pkgrel=1
pkgdesc="Resource monitor"
url="https://github.com/aristocratos/btop"
license="Apache-2.0"
arch="all"
depends="libc++"
makedepends="qnx-io-sock-dev libc++-dev"
source="https://github.com/qnx-ports/btop/archive/qnx-$_pkgver-rc$pkgrel/btop-$_pkgver-rc$pkgrel.tar.gz"
builddir="$srcdir"/$pkgname-qnx-$_pkgver-rc$pkgrel
options="!check" # no test suite

build() {
	make 
}

package() {
	make install DESTDIR="$pkgdir" PREFIX=/usr

	rm -rf "$pkgdir"/usr/share/doc/
}



