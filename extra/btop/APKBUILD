pkgname=btop
pkgver=1.4.6
pkgrel=1
pkgdesc="Resource monitor"
url="https://github.com/aristocratos/btop"
license="Apache-2.0"
arch="all"
depends="libc++"
makedepends="qnx-io-sock-dev libc++-dev ncurses-dev"
source="https://github.com/qnx-ports/btop/archive/qnx-$pkgver-r$pkgrel/btop-$pkgver-r$pkgrel.tar.gz"
builddir="$srcdir"/$pkgname-qnx-$pkgver-r$pkgrel
options="!check" # no test suite

build() {
	make 
}

package() {
	make install DESTDIR="$pkgdir" PREFIX=/usr

	rm -rf "$pkgdir"/usr/share/doc/
}

