# Alpine-Contributor: Patrycja Rosa <alpine@ptrcnull.me>
# Alpine-Maintainer: Patrycja Rosa <alpine@ptrcnull.me>
# Maintainer: Aaron Bassett <abassett@qnx.com>
pkgname=labwc
pkgver=0.20.2
pkgrel=0
pkgdesc="Wayland stacking compositor"
url="https://github.com/labwc/labwc"
arch="all"
license="GPL-2.0-only"
depends="wlroots glib cairo libxml2 pango libsfdo"
makedepends="
	cairo-dev
	glib-dev
	libxml2-dev
	meson
	pango-dev
	scdoc
	wayland-protocols
	wlroots0.20-dev
	libsfdo-dev
    linux-headers-input-codes
	qnx-fd-notify-dev
	"
subpackages="$pkgname-doc $pkgname-lang"
source="https://github.com/qnx-ports/labwc/archive/refs/heads/qnx-$pkgver.tar.gz
	remove-aports-git-version.patch
	"
builddir="$srcdir/labwc-qnx-$pkgver"

prepare() {
	default_prepare
}

build() {
	abuild-meson . output -Dman-pages=enabled -Dc_link_args="-ltimerfd -lsignalfd"
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}


