e47e63b07ac05a175c033f1e1110af9e5e45b8f7539a7e194a0f22bb4931ed5f2bcfa9a887b5fb67c22f1132f7833ba5c6ab6853d754f8cd3b87caa31f7e6992  remove-aports-git-version.patch
