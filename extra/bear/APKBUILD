# Contributor: Sören Tempel <soeren+alpine@soeren-tempel.net>
# Maintainer:
pkgname=bear
pkgver=4.1.3
pkgrel=0
pkgdesc="Tool that generates a compilation database for clang tooling"
url="https://github.com/rizsotto/Bear"
arch="all"
license="GPL-3.0-or-later"
makedepends=""
subpackages="$pkgname-doc"
source="https://github.com/rizsotto/Bear/archive/$pkgver/bear-$pkgver.tar.gz"
builddir="$srcdir/Bear-$pkgver"
options="!check"

prepare() {
	default_prepare

    echo '[patch.crates-io]' >> "$builddir"/Cargo.toml
    echo 'libc = { git = "https://github.com/qnx-ports/libc-rs", branch = "qnx-0.2.183" }' >>  "$builddir"/Cargo.toml
    echo 'cc = { git = "https://github.com/qnx-ports/cc-rs", branch = "qnx-1.2.48" }' >> "$builddir"/Cargo.toml

    cargo update
}

build() {
	cargo build --release -p bear
}

check() {
    default_check

	# cargo test --frozen
}

package() {
	DESTDIR="$pkgdir" PREFIX="/usr" "$builddir"/scripts/install.sh
}



sha512sums="
6931b877c32880e3198bccacd8b90aecacfa8ab992c55ae7dcb53ecbbd6247afe25e1e1b0eddb42ec50448844ae7e97ea4202785fb9e62d5d3441ff6fe44165b  bear-4.1.3.tar.gz
"
