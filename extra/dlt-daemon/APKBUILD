# Maintainer:Ramya santoshi <rtimmaraju@qnx.com>
pkgname=dlt-daemon
pkgver=3.0.0
pkgrel=0
pkgdesc="Diagnostic Log and Trace (DLT) daemon"
url="https://github.com/COVESA/dlt-daemon"
arch="all"
license="MPL-2.0"

makedepends="cmake make libc++-dev zlib-dev qnx-io-sock-dev qnx-libjson-dev qnx-slogger2-dev"
depends="libc++ qnx-io-sock qnx-libjson qnx-slogger2"

source="dlt-daemon-${pkgver}.tar.gz::https://github.com/qnx-ports/dlt-daemon/archive/refs/heads/qnx-v3.0.0.tar.gz dlt-daemon-3.0-qnx-clang.patch"

builddir="$srcdir/dlt-daemon-qnx-v3.0.0"

subpackages="$pkgname-dev"

build() {
    export CXXFLAGS="$CXXFLAGS -Qunused-arguments -Wno-error=missing-designated-field-initializers"
    export CFLAGS="$CFLAGS -Qunused-arguments"
    cmake -B build -S "$builddir" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DWITH_SYSTEMD=OFF \
        -DWITH_DOC=OFF \
        -DWITH_MAN=OFF \
        -DWITH_DBUS=OFF \
        -DWITH_OFFLINE_LOGSTORAGE=OFF \
        -DWITH_DLT_QNX_SYSTEM=ON\
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_TESTING=OFF \
        -DWITH_DLT_CXX11_EXT=ON \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5

    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
} 
