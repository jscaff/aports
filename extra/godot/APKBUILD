_platform_files=$(find platform -type f)
source="
    https://github.com/godotengine/godot/archive/refs/tags/$pkgver-stable.tar.gz
    input-event-codes.h
    0001-add-qnx-platform.patch
    0002-somehow-invalid-syntax.patch
    0003-egl-patches.patch
    $_platform_files
"

options="!check" # No tests
builddir="$startdir"/src/godot-"$pkgver"-stable
_sconsflags="
    module_camera_enabled=false
    builtin_brotli=false
    builtin_freetype=false
    builtin_graphite=false
    builtin_harfbuzz=false
    builtin_icu4c=false
