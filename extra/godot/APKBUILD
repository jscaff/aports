case "$CARCH" in
x86_64)
    ;;
*)
    # only builds on x86_64
    _sconsflags="$_sconsflags module_denoise_enabled=false"
    ;;
esac

prepare() {
    default_prepare

        _cp_platform_files

# magic sauce to put the files in the right place since abuild just flattens everything
    # echo $_platform_files | tr ' ' '\n' | sed -r 's/(.*?)(\/)([^\/]*$)/\"\1\" \"\3\"/' | xargs -n 2 _cp_platform_file
# echo $_platform_files | tr ' ' '\n' | sed -r 's/(.*?)((\/)[^\/]*$)/mkdir -p \"\$pkgdir\/\1" \&\& cp \"\$srcname\2\" \"\$pkgdir\/platform\/qnx\2\"/'

    ln -sf "../linuxbsd/wayland" "$builddir/platform/qnx/wayland"
}

_cp_platform_files() { 
    for file in $_platform_files;
    do
        _dirname=$(echo $file | sed -r 's/(.*?)(\/)([^\/]*$)/\1/')  # regex magic
        _basename=$(echo $file | sed -r 's/(.*?)(\/)([^\/]*$)/\3/') # regex magic
        mkdir -p "$builddir/$_dirname"
        cp "$srcdir/$_basename" "$builddir/$_dirname/$_basename"

    done
}

build() {
    mkdir -p "$builddir/linux"
    cp "$srcdir/input-event-codes.h" "$builddir/linux"

    export BUILD_NAME="qnx_self_hosted"
    for target in editor; do
        scons -j$(nproc) \
            platform=qnx \
            target=$target \
            arch=$CARCH \
            CC=clang \
            CXX=clang++ \
            $_sconsflags 
    done
}

package() {
    pkgdesc="$pkgdesc (GUI editor)"
    install -Dm644 misc/dist/linux/org.godotengine.Godot.desktop \
        -t "$pkgdir"/usr/share/applications/
    install -Dm644 misc/dist/linux/org.godotengine.Godot.appdata.xml \
        -t "$pkgdir"/usr/share/metainfo/
    install -Dm644 icon.png "$pkgdir"/usr/share/icons/hicolor/256x256/apps/godot.png
    install -Dm644 icon.svg "$pkgdir"/usr/share/icons/hicolor/scalable/apps/godot.svg
    # install -Dm644 misc/dist/linux/godot.6 -t "$pkgdir"/usr/share/man/man6/
    install -Dm755 bin/godot.*.editor.dev* "$pkgdir"/usr/bin/godot
    #install -Dm755 bin/godot.*.template_debug.* "$pkgdir"/usr/bin/godot-template-debug
    # install -Dm755 bin/godot.*.template_release.* "$pkgdir"/usr/bin/godot-template-release
}

templates() {
    pkgdesc="$pkgdesc (templates)"
    depends="
        glib
        harfbuzz-icu
        libbz2
        libc++
        libiconv
        libintl
        libpcre2-32
        libsharpyuv
        libxkbcommon
        qnx-egl
        qnx-gcc-libs
        qnx-gles
        qnx-io-sock
        qnx-libslog2
        qnx-screen
        zlib-ng
        zstd-libs
        "
    amove usr/bin/*template*
}

