From 5d09813164e2866e41d880e4acd65dcdbb1cd2a0 Mon Sep 17 00:00:00 2001
From: Leo Shen <i@szclsya.me>
Date: Tue, 21 Apr 2026 16:56:08 -0400
Subject: [PATCH 3/3] qnx: misc fixes

- fix unzip command arugment order
- add workaround for clang
---
 abuild.in    | 2 +-
 default.conf | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/abuild.in b/abuild.in
index 69c6da8..022b80b 100644
--- a/abuild.in
+++ b/abuild.in
@@ -542,7 +542,7 @@ default_unpack() {
 				tar -C "$srcdir" --zstd -xf "$s" || return 1;;
 			*.zip)
 				msg "Unpacking $s..."
-				unzip -n -q "$s" -d "$srcdir" || return 1;;
+				unzip -n -q -d "$srcdir" "$s" || return 1;;
 		esac
 	done
 }
diff --git a/default.conf b/default.conf
index 681a88f..6f217ea 100644
--- a/default.conf
+++ b/default.conf
@@ -1,5 +1,5 @@
-export CFLAGS="-Os -fstack-clash-protection -Wformat -Werror=format-security"
-export CXXFLAGS="-Os -fstack-clash-protection -Wformat -Werror=format-security"
+export CFLAGS="-Os -fstack-clash-protection -Wformat -Werror=format-security -Qunused-arguments"
+export CXXFLAGS="-Os -fstack-clash-protection -Wformat -Werror=format-security -Qunused-arguments"
 export CXXFLAGS="$CXXFLAGS -D_GLIBCXX_ASSERTIONS=1 -D_LIBCPP_ENABLE_THREAD_SAFETY_ANNOTATIONS=1 -D_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_FAST"
 export LDFLAGS="-Wl,--as-needed,-O1,--sort-common"
 export GOFLAGS="-buildmode=pie -modcacherw -trimpath -buildvcs=false"
-- 
2.54.0

