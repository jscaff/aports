# Maintainer: Leo Shen <yishen@qnx.com>
pkgname=abuild
pkgver=3.16.0
pkgrel=0
pkgdesc="APK build toolchain, adapted for QNX"
url="https://gitlab.alpinelinux.org/alpine/abuild/"
arch="all"
license="GPL-2.0-only"
makedepends="scdoc pkgconf pkgconf-dev openssl-dev zlib-ng-dev"
depends="qnx-utils nproc apk-tools fakeroot busybox openssl pkgconf pax-utils libssl3 libcrypto3 zlib-ng gawk curl bc"
options="suid"
subpackages="$pkgname-doc"
source="https://gitlab.alpinelinux.org/alpine/abuild/-/archive/$pkgver/abuild-$pkgver.tar.gz
    0001-qnx-remove-features-not-used-by-QNX.patch
    0002-qnx-add-BUILDINFO.patch
    0003-qnx-misc-fixes.patch
"
builddir="$srcdir"/abuild-$pkgver

build() {
    make VERSION="$pkgver-r$pkgrel"
}

package() {
    make install VERSION="$pkgver-r$pkgrel" DESTDIR="$pkgdir"
}

