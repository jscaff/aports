# Maintainer: Leo Shen <yishen@qnx.com>
pkgname=openssh
pkgver=10.3_p1
_myver=${pkgver%_*}${pkgver#*_}
pkgrel=0
pkgdesc="Port of OpenBSD's free SSH release"
url="https://www.openssh.com/portable.html"
arch="all"
license="SSH-OpenSSH"
options="suid"
depends="libcrypto3 zlib-ng qnx-io-sock qnx-security"
makedepends="openssl-dev>3 zlib-ng-dev qnx-io-sock-dev qnx-security-dev"
subpackages="$pkgname-doc $pkgname-openrc"
source="https://ftp.openbsd.org/pub/OpenBSD/OpenSSH/portable/openssh-$_myver.tar.gz
    fix-qnx-build.patch
    99-qnx.conf
    sshd.pam
    sshd.initd
    sshd.confd
"
builddir="$srcdir"/$pkgname-$_myver

prepare() {
    default_prepare
    # remove variable (but useless) first line in config (related to upstream VCS)
    sed '/^#.*\$.*\$$/d' -i ssh_config
    sed '/^#.*\$.*\$$/d' -i sshd_config

    # prepend configuration option to include drop-in configuration files for sshd_config
    printf "# Include drop-in configurations\nInclude /etc/ssh/sshd_config.d/*.conf\n" | cat - sshd_config > sshd_config.tmp
    mv -v sshd_config.tmp sshd_config
    # prepend configuration option to include drop-in configuration files for ssh_config
    printf "# Include drop-in configurations\nInclude /etc/ssh/ssh_config.d/*.conf\n" | cat - ssh_config > ssh_config.tmp
    mv -v ssh_config.tmp ssh_config
}

build() {
    ./configure \
        ac_cv_func_bzero=yes \
        ac_cv_func_bindresvport_sa=no \
        --build="$CBUILD" \
        --host="$CHOST" \
        --prefix=/usr \
        --sysconfdir=/etc/ssh \
        --libexecdir=/usr/lib/ssh \
        --sbindir=/usr/bin \
        --with-privsep-path=/var/lib/sshd \
        --with-default-path="/usr/local/bin:/usr/bin" \
        --disable-lastlog \
        --disable-strip \
        --disable-utmp \
        --disable-wtmp \
        --with-mantype=man \
        --with-pam \
        --with-ssl-engine \
        --without-hardening
    make
}

package() {
    make DESTDIR="$pkgdir" install
    install -v -m755 contrib/ssh-copy-id "$pkgdir"/usr/bin
    install -v -m755 contrib/ssh-copy-id.1 "$pkgdir"/usr/share/man/man1

    # Licenses
    install -v -m755 -d "$pkgdir"/usr/share/doc/openssh-"$_myver"
    install -v -m644 INSTALL LICENCE OVERVIEW README* \
            "$pkgdir"/usr/share/doc/openssh-"$_myver"

    # QNX's default sshd config
    echo "Include /etc/ssh/sshd_config.d/*.conf" >> "$pkgdir"/etc/ssh/sshd_config
    install -v -m755 -d "$pkgdir"/etc/ssh/sshd_config.d
    install -v -m644 ../99-qnx.conf "$pkgdir"/etc/ssh/sshd_config.d
    # QNX specific PAM settings
    install -v -m755 -d "$pkgdir"/etc/pam.d
    install -v -m644 ../sshd.pam "$pkgdir"/etc/pam.d/sshd
    
    # OpenRC init scripts
    install -Dm755 "$srcdir"/sshd.initd "$pkgdir"/etc/init.d/sshd
    install -Dm644 "$srcdir"/sshd.confd "$pkgdir"/etc/conf.d/sshd
}

