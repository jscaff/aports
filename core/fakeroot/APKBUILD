# Maintainer: Leo Shen <yishen@qnx.com>
pkgname=fakeroot
pkgver=1.38.1
pkgrel=1
pkgdesc="Tool for simulating superuser privileges"
url="https://packages.debian.org/fakeroot"
arch="all"
license="GPL-3.0-or-later"
subpackages="$pkgname-doc"
depends="qnx-io-sock"
makedepends="autoconf automake libtool qnx-io-sock-dev"
source="https://deb.debian.org/debian/pool/main/f/fakeroot/fakeroot_$pkgver.orig.tar.gz
    fix-qnx.patch
    fix-chown.patch
"

prepare() {
    default_prepare
    ./bootstrap
}

build() {
    ./configure \
        --build="$CBUILD" \
        --host="$CHOST" \
        --prefix=/usr \
        --disable-static \
        --with-ipc=tcp
    make
}

package() {
    make DESTDIR="$pkgdir" install
}
