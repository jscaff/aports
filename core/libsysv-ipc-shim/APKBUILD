# Maintainer: Aaron Bassett <abassett@qnx.com>
pkgname=libsysv-ipc-shim
pkgver=0.1.0
pkgrel=4
pkgdesc="QNX ipc.h shim"
url="https://qnx.com"
arch="all"
license="LicenseRef-QDL-Non-Commercial"
options="!check"
makedepends="clang cmake gtest-dev libc++-dev ninja"
checkdepends="gtest libc++"
subpackages="$pkgname-dev"
source="$pkgname-v$pkgver-r$pkgrel.tar.gz::https://github.com/qnx-ports/libsysv-ipc-shim/archive/refs/tags/v$pkgver-r$pkgrel.tar.gz
    "
builddir="$srcdir/$pkgname-$pkgver-r$pkgrel"

build() {
    # Testing and install are enabled by default.
    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_INCLUDEDIR=include/shims \
        -DBUILD_SHARED_LIBS=ON
    cmake --build build
}

check() {
    ctest --test-dir build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}

dev() {
    default_dev
    depends="$pkgname=$pkgver-r$pkgrel"
}

sha512sums="
c4ccb173abe3cf27bc583aac00fb8aa0892ef4df2dc5991faf8ce4d9b905c312f5f85eb0fd3d43119b42de59d2f3923f118f413ff43b6c24a01c1290e091cbc3  libsysv-ipc-shim-v0.1.0-r4.tar.gz
"
