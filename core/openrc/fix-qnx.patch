From 3506153450f8ed079ae3a1f7594ea37982d7b56d Mon Sep 17 00:00:00 2001
From: Leo Shen <i@szclsya.me>
Date: Thu, 29 Jan 2026 19:44:26 +0000
Subject: [PATCH] qnx fixes

---
 init.d/meson.build          | 5 +++++
 meson.build                 | 2 +-
 sh/start-stop-daemon.sh     | 7 ++++++-
 src/librc/librc-daemon.c    | 2 +-
 src/librc/librc-depend.c    | 3 ++-
 src/librc/librc.c           | 8 ++++++++
 src/meson.build             | 6 +++---
 src/openrc-run/openrc-run.c | 2 ++
 src/openrc/rc-logger.c      | 2 ++
 src/shared/helpers.h        | 2 ++
 10 files changed, 32 insertions(+), 7 deletions(-)

diff --git a/init.d/meson.build b/init.d/meson.build
index d0699dcf..91a5dc29 100644
--- a/init.d/meson.build
+++ b/init.d/meson.build
@@ -82,6 +82,9 @@ init_NetBSD =  [
   'wscons.in',
   ]
 
+init_QNX = [
+  ]
+
 init_data = init_common
 if os == 'dragonfly'
   init_data = init_data + init_BSD
@@ -91,6 +94,8 @@ elif os == 'linux'
   init_data = init_data + init_Linux
 elif os == 'netbsd'
   init_data = init_data + init_BSD + init_NetBSD
+elif os == 'qnx'
+  init_data = init_QNX
   endif
 
 foreach init_d_file : init_data
diff --git a/meson.build b/meson.build
index a98a25b2..0a3ea781 100644
--- a/meson.build
+++ b/meson.build
@@ -56,7 +56,7 @@ pkg_prefix = get_option('pkg_prefix')
 if pkg_prefix == ''
   if os == 'dragonfly' or os == 'freebsd'
     pkg_prefix = '/usr/local'
-  elif os == 'gnu' or os == 'linux'
+  elif os == 'gnu' or os == 'linux' or os == 'qnx'
     pkg_prefix = '/usr'
   elif os == 'netbsd'
     pkg_prefix = '/usr/pkg'
diff --git a/sh/start-stop-daemon.sh b/sh/start-stop-daemon.sh
index b8706128..87f4d326 100644
--- a/sh/start-stop-daemon.sh
+++ b/sh/start-stop-daemon.sh
@@ -25,6 +25,11 @@ ssd_start()
 		notify="$ready"
 	fi
 
+	if [ -z "$priority" ]; then
+		# Default QNX service priority, just slightly higher than user processes
+		priority=20
+	fi
+
 	local _background=
 	ebegin "Starting ${name:-$RC_SVCNAME}"
 	if yesno "${command_background}"; then
@@ -46,7 +51,7 @@ ssd_start()
 	#the eval call is necessary for cases like:
 	# command_args="this \"is a\" test"
 	# to work properly.
-	eval start-stop-daemon --start \
+	eval on -p "$priority" start-stop-daemon --start \
 		--exec $command \
 		${chroot:+--chroot} $chroot \
 		${directory:+--chdir} $directory \
diff --git a/src/librc/librc-daemon.c b/src/librc/librc-daemon.c
index 19028755..9a77fb64 100644
--- a/src/librc/librc-daemon.c
+++ b/src/librc/librc-daemon.c
@@ -32,7 +32,7 @@
 #include "helpers.h"
 
 #if defined(__linux__) || (defined (__FreeBSD_kernel__) && defined(__GLIBC__)) \
-	|| defined(__GNU__)
+	|| defined(__GNU__) || defined(__QNX__)
 static bool
 pid_is_exec(pid_t pid, const char *exec)
 {
diff --git a/src/librc/librc-depend.c b/src/librc/librc-depend.c
index c7ef4dcd..8c1df504 100644
--- a/src/librc/librc-depend.c
+++ b/src/librc/librc-depend.c
@@ -25,8 +25,9 @@
 #include <stdlib.h>
 #include <string.h>
 #include <sys/stat.h>
-#include <time.h>
 #include <unistd.h>
+#include <time.h>
+extern time_t time(time_t *__timer);
 
 #include "queue.h"
 #include "librc.h"
diff --git a/src/meson.build b/src/meson.build
index 5e5af649..3867c2e3 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -6,16 +6,16 @@ subdir('libeinfo')
 subdir('shared')
 subdir('checkpath')
 subdir('einfo')
-subdir('fstabinfo')
+#subdir('fstabinfo')
 subdir('halt')
 subdir('is_newer_than')
 subdir('is_older_than')
 subdir('kill_all')
 subdir('mark_service')
-subdir('mountinfo')
+#subdir('mountinfo')
 subdir('on_ac_power')
 subdir('openrc')
-subdir('openrc-init')
+#subdir('openrc-init')
 subdir('openrc-run')
 subdir('openrc-shutdown')
 subdir('openrc-user')
diff --git a/src/openrc-run/openrc-run.c b/src/openrc-run/openrc-run.c
index f8c16394..dfbb2109 100644
--- a/src/openrc-run/openrc-run.c
+++ b/src/openrc-run/openrc-run.c
@@ -43,6 +43,8 @@
 #  include <pty.h>
 #elif defined(__NetBSD__) || defined(__OpenBSD__)
 #  include <util.h>
+#elif defined(__QNX__)
+#  include <unix.h>
 #else
 #  include <libutil.h>
 #endif
diff --git a/src/openrc/rc-logger.c b/src/openrc/rc-logger.c
index e57d3803..b6f12dad 100644
--- a/src/openrc/rc-logger.c
+++ b/src/openrc/rc-logger.c
@@ -36,6 +36,8 @@
 #  include <pty.h>
 #elif defined(__NetBSD__) || defined(__OpenBSD__)
 #  include <util.h>
+#elif defined(__QNX__)
+#  include <unix.h>
 #else
 #  include <libutil.h>
 #endif
diff --git a/src/shared/helpers.h b/src/shared/helpers.h
index 6d233a35..208b09a6 100644
--- a/src/shared/helpers.h
+++ b/src/shared/helpers.h
@@ -29,6 +29,7 @@
 #include <dirent.h>
 #include <unistd.h>
 #include <fcntl.h>
+#include <sys/memstream.h>
 
 #define ERRX do { fprintf (stderr, "out of memory\n"); exit (1); } while (0)
 
@@ -237,3 +238,4 @@ RC_UNUSED static ssize_t xgetline(char **restrict lineptr, size_t *restrict n, F
 }
 
 #endif
+
